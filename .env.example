# 이 프로젝트에서 사용하는 환경 변수 템플릿
# 사용법: 이 파일을 복사해 .env.local을 만들고 실제 값을 채워주세요.
#   cp .env.example .env.local

# 백엔드 API 베이스 URL (필수)
NEXT_PUBLIC_BACKEND_URL="https://api.lighty.today"

# 카카오 로그인 REST API 키 (필수, https://developers.kakao.com)
NEXT_PUBLIC_KAKAO_REST_API_KEY=""

# 카카오 로그인 리다이렉트 URI (필수, 카카오 개발자 콘솔 등록값과 일치)
NEXT_PUBLIC_REDIRECT_URI="http://localhost:3000/auth/kakao/login"

# Google Analytics 측정 ID (선택)
NEXT_PUBLIC_GOOGLE_ANALYTICS=""

# Google Tag Manager 컨테이너 ID (선택)
NEXT_PUBLIC_GTM_ID=""

# 번들 분석기 활성화 여부 (선택, next build 시에만 사용)
ANALYZE=""
